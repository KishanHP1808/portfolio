{
  "entities": {
    "user_profile": {
      "title": "User Profile",
      "description": "Authenticated visitor or recruiter profile securely tracked via Firebase Auth",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user ID"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "User email address"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL"
        },
        "savedProjects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of saved/bookmarked project IDs"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Recruiter private scratchpad or notes"
        },
        "lastActiveAt": {
          "type": "string",
          "description": "Last active ISO timestamp"
        }
      },
      "required": ["uid", "lastActiveAt"]
    },
    "inquiry": {
      "title": "Contact Inquiry",
      "description": "Direct message or project inquiry submitted by a portfolio visitor",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Visitor or organization name"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150,
          "description": "Visitor contact email"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Message or project inquiry body"
        },
        "createdAt": {
          "type": "string",
          "description": "Submission ISO timestamp"
        },
        "userId": {
          "type": "string",
          "description": "Optional authenticated visitor UID"
        }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "project_like": {
      "title": "Project Like",
      "description": "Appreciation count for individual showcase projects",
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Identifier of the portfolio project"
        },
        "likesCount": {
          "type": "number",
          "description": "Aggregate number of endorsements/likes"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["projectId", "likesCount", "updatedAt"]
    },
    "guestbook_entry": {
      "title": "Guestbook Entry",
      "description": "Public visitor note or endorsement for Kishan's portfolio",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Visitor name"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Role or affiliation e.g. Recruiter, Designer, Engineer"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Note or feedback message"
        },
        "createdAt": {
          "type": "string",
          "description": "Entry creation timestamp"
        },
        "userId": {
          "type": "string",
          "description": "Optional verified Firebase Auth user ID"
        },
        "avatarUrl": {
          "type": "string",
          "description": "Optional profile picture URL from Google Auth"
        }
      },
      "required": ["name", "role", "message", "createdAt"]
    },
    "analytics_event": {
      "title": "Analytics Event",
      "description": "Lightweight telemetry log of visitor interactions such as button clicks and modal openings",
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Type of event (button_click, modal_open, etc.)"
        },
        "eventName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Descriptive identifier of the action"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "ISO timestamp of event occurrence"
        },
        "target": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional UI element target identifier"
        },
        "category": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional category (modal, button, filter, etc.)"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Ephemeral browser session identifier"
        },
        "path": {
          "type": "string",
          "maxLength": 256,
          "description": "Current URL route/hash path"
        },
        "metadata": {
          "type": "object",
          "description": "Arbitrary key-value metadata associated with the event"
        }
      },
      "required": ["eventType", "eventName", "timestamp"]
    },
    "google_skills_profile": {
      "title": "Google Skills Profile",
      "description": "Accreditation and points tracker for Google Cloud Skills Boost / Qwiklabs account (4mn24ci023@gmail.com)",
      "type": "object",
      "properties": {
        "accountEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Google Skills account email (4mn24ci023@gmail.com)"
        },
        "totalPoints": {
          "type": "number",
          "description": "Accumulated Google Skills / Arcade points"
        },
        "tier": {
          "type": "string",
          "maxLength": 128,
          "description": "Skill tier or ranking title"
        },
        "skillBadgesCount": {
          "type": "number",
          "description": "Count of official Google Cloud skill badges earned"
        },
        "questsCompleted": {
          "type": "number",
          "description": "Count of learning quests completed"
        },
        "labsCompleted": {
          "type": "number",
          "description": "Count of hands-on cloud labs completed"
        },
        "profileUrl": {
          "type": "string",
          "maxLength": 300,
          "description": "Public Google Cloud Skills Boost profile URL"
        },
        "arcadeMilestone": {
          "type": "string",
          "maxLength": 128,
          "description": "Arcade milestone status e.g. Tier 3 Champion"
        },
        "source": {
          "type": "string",
          "maxLength": 64,
          "description": "Sync mechanism (google_api, profile_scraper, firestore, server_cache)"
        },
        "lastSyncedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "Timestamp of last live polling sync"
        },
        "recentBadges": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of recently earned Google Cloud skill badges"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last skill upgrade"
        }
      },
      "required": ["accountEmail", "totalPoints", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user_profile",
      "description": "User profile with saved bookmarks and recruitment notes, accessible only by owner"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Collection of visitor inquiries and contact messages"
    },
    "/project_likes/{projectId}": {
      "schema": "project_like",
      "description": "Real-time appreciation reactions for showcase projects"
    },
    "/guestbook/{entryId}": {
      "schema": "guestbook_entry",
      "description": "Public endorsements and visitor guestbook notes"
    },
    "/analytics_events/{eventId}": {
      "schema": "analytics_event",
      "description": "Write-only telemetry log of visitor interactions"
    },
    "/google_skills/{skillId}": {
      "schema": "google_skills_profile",
      "description": "Upgradable Google Skills Boost points and badges for 4mn24ci023@gmail.com"
    }
  }
}
